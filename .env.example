# Airtable credentials for NJCIC Grantees Map
# Copy this file to .env and fill in your values

# Airtable Personal Access Token (PAT)
# Get one from: https://airtable.com/create/tokens
AIRTABLE_PAT=your_pat_here

# Airtable Base ID (starts with "app")
AIRTABLE_BASE_ID=appryDZWgPpP0GmZw

# Airtable Table ID (starts with "tbl")
AIRTABLE_TABLE_ID=tblFADXYCq495smGH

# Airtable View ID (starts with "viw") - optional
AIRTABLE_VIEW_ID=viwjXro41ehrvxTfs
